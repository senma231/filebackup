{
  "full_disk_scan": true,
  "scan_paths": [
    "C:\\Users\\%USERNAME%\\Documents"
  ],
  "file_types": [
    ".doc",
    ".docx",
    ".xls",
    ".xlsx",
    ".ppt",
    ".pptx",
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg"
  ],
  "exclude_patterns": [
    "*.log",
    "*.tmp",
    "~$*"
  ],
  "max_file_size": 104857600,
  "incremental_scan": true,
  "email": "",
  "email_prefix": "",
  "server_url": "http://localhost:8889",
  "agent_id": "",
  "token": "",
  "heartbeat_interval": 30,
  "sftp_config": {
    "host": "localhost",
    "port": 22,
    "username": "",
    "password": "",
    "key_path": "",
    "remote_path": "/uploads"
  },
  "service_mode": true,
  "log_level": "info",
  "log_path": "C:\\Users\\%USERNAME%\\AppData\\Local\\DocScannerAgent\\logs",
  "compress_enabled": true,
  "encrypt_config": false
}
